#!/sbin/sh
OUTFD=$2
ZIPFILE=$3

ui_print() {
echo "ui_print $1" > /proc/self/fd/$OUTFD
echo "ui_print" > /proc/self/fd/$OUTFD
}

abort() {
ui_print "$1"
exit 1
}

# 环境检测
if [ -f /data/adb/ksu/ksu ]; then
KERNELSU=true
MODPATH="/data/adb/modules/enable-hdr-oneplus13-webui"
ui_print "- KernelSU environment detected"
else
KERNELSU=false
ui_print "- Magisk environment detected"
mount /data 2>/dev/null
if [ -f /data/adb/magisk/util_functions.sh ]; then
. /data/adb/magisk/util_functions.sh
fi
if [ "$BOOTMODE" != "true" ]; then
abort "Please install via Magisk Manager"
fi
fi

ui_print "=============================================="
ui_print " Enable HDR for OnePlus 13 (WebUI)"
ui_print " Version: v1.6.6"
ui_print "=============================================="

# 获取设备信息
DEVICE_MODEL=`getprop ro.product.model`
ui_print "- Device: $DEVICE_MODEL"

# 创建目录
ui_print "- Creating module directory"
mkdir -p "$MODPATH"
if [ ! -d "$MODPATH" ]; then
abort "Failed to create module directory"
fi

# 解压文件
ui_print "- Extracting module files"
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2
if [ $? -ne 0 ]; then
abort "Failed to extract files"
fi

# 设置权限
ui_print "- Setting permissions"
chmod -R 755 "$MODPATH"
chmod 644 "$MODPATH/module.prop"
chmod 755 "$MODPATH"/*.sh

# 创建必要目录
mkdir -p "$MODPATH/backup"
mkdir -p "$MODPATH/webroot"

# 验证
ui_print "- Verifying installation"
if [ ! -f "$MODPATH/module.prop" ]; then
abort "module.prop not found"
fi

# 调用customize.sh（如果存在）
if [ -f "$MODPATH/customize.sh" ]; then
ui_print "- Running module customization"
. "$MODPATH/customize.sh"
fi

ui_print "- Installation completed successfully"
ui_print "- Reboot required to activate module"

exit 0